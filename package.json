{
  "name": "financas-pessoais",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "build:cloudflare": "npm run build",
    "cf:dry-run": "npm run build:cloudflare && wrangler deploy --dry-run",
    "cf:deploy": "npm run build:cloudflare && wrangler deploy",
    "cf:migrate": "wrangler d1 migrations apply DB --remote",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.24.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.4",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "type": "module",
  "displayName": "Nexo Finanças Pessoais"
}
